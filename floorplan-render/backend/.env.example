# 户型图 AI 生成装修效果图 API 配置

# 通义万相 API 密钥（从阿里云百炼平台获取）
# 申请地址: https://bailian.console.aliyun.com/
TONGYI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 文件存储目录（相对路径，相对于 backend 目录）
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# 文件大小限制（字节），默认 50MB
MAX_FILE_SIZE=52428800

# 允许的文件扩展名（逗号分隔）
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,dxf

# 解析超时时间（秒）
PARSE_TIMEOUT=30

# CORS 允许的源（逗号分隔，* 表示允许所有）
CORS_ORIGINS=*
